# =============================================================================
# Domus Finance — template de variáveis de ambiente
#
#   cp .env.example .env
#
# Este arquivo é versionado e não contém nenhum valor funcional: apenas os nomes
# das variáveis e as instruções de preenchimento. O `.env` efetivo é ignorado
# pelo Git e não deve ser commitado em hipótese alguma.
#
# Variáveis deixadas em branco assumem o padrão declarado no docker-compose.yml,
# com uma exceção: JWT_CHAVE não tem padrão, e a API se recusa a iniciar sem ela.
# =============================================================================


# -----------------------------------------------------------------------------
# Obrigatórias
# -----------------------------------------------------------------------------

# Segredo usado para assinar os tokens de acesso. Mínimo de 32 caracteres.
# Não há valor padrão: a API falha na inicialização, com mensagem explícita, se
# esta variável estiver ausente ou for mais curta que o mínimo. Falhar cedo é
# preferível a subir com assinatura enfraquecida.
# Gere um valor aleatório e exclusivo desta instalação, por exemplo:
#   openssl rand -base64 48
JWT_CHAVE=


# -----------------------------------------------------------------------------
# Banco de dados
#
# Em branco, valem: domus_finance / postgres / postgres. Aceitável para uma
# execução local descartável; defina valores próprios em qualquer outro caso.
# O nome e o usuário são criados na primeira execução do container e ficam
# gravados no volume: alterá-los depois exige recriar o volume.
# -----------------------------------------------------------------------------

# Nome do banco. Letras minúsculas, números e sublinhado, começando por letra.
POSTGRES_DB=

# Usuário dono do banco.
POSTGRES_USER=

# Senha do usuário do banco. Não reaproveite senhas de outros sistemas.
POSTGRES_PASSWORD=


# -----------------------------------------------------------------------------
# Portas publicadas no host
#
# Preencha apenas em caso de conflito com algo já em execução na sua máquina.
# Padrões: cliente 5173, API 8080, banco 5432.
# -----------------------------------------------------------------------------

WEB_PORT=
API_PORT=
DB_PORT=


# -----------------------------------------------------------------------------
# Endereços derivados das portas
#
# As duas variáveis abaixo só precisam ser preenchidas se você tiver alterado
# WEB_PORT ou API_PORT — os padrões pressupõem as portas padrão. Deixá-las
# desalinhadas das portas quebra o cliente: a origem seria barrada pelo CORS,
# ou as requisições iriam para um endereço onde a API não responde.
# -----------------------------------------------------------------------------

# Origem do cliente liberada no CORS da API. Precisa acompanhar WEB_PORT.
# Padrão: http://localhost:5173
FRONTEND_ORIGIN=

# Base da API gravada no bundle do cliente em tempo de build. É o endereço visto
# pelo navegador, não o nome do serviço na rede interna do Compose. Precisa
# acompanhar API_PORT.
# Padrão: http://localhost:8080/api
VITE_API_URL=


# -----------------------------------------------------------------------------
# Token de acesso
#
# Opcionais. Padrões: DomusFinance, DomusFinanceApp e 8 horas de validade.
# -----------------------------------------------------------------------------

JWT_EMISSOR=
JWT_AUDIENCIA=
JWT_HORAS_VALIDADE=
