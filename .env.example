# Copie para .env e preencha os valores antes de subir os serviços:
#   cp .env.example .env

# Banco de dados
POSTGRES_DB=nome-do-banco
POSTGRES_USER=usuario-do-banco
POSTGRES_PASSWORD=defina-uma-senha

# Portas e origem do cliente
API_PORT=8080
DB_PORT=5432
WEB_PORT=5173

# Origem liberada no CORS da API. Precisa acompanhar WEB_PORT.
FRONTEND_ORIGIN=http://localhost:5173

# Base da API gravada no bundle do cliente em tempo de build. É o endereço
# visto pelo navegador, e precisa acompanhar API_PORT.
VITE_API_URL=http://localhost:8080/api

# Chave de assinatura do token — mínimo 32 caracteres.
# Nunca versionar o valor real: o .env efetivo é ignorado pelo Git.
JWT_CHAVE=defina-uma-chave-de-no-minimo-32-caracteres
JWT_EMISSOR=DomusFinance
JWT_AUDIENCIA=DomusFinanceApp
JWT_HORAS_VALIDADE=8
